{
    "name": "nocuft-workspace",
    "private": true,
    "workspaces": [
        "packages/generator",
        "packages/sdk",
        "packages/dfir",
        "packages/compiler",
        "packages/frontends/typescript",
        "packages/deployment",
        "packages/client",
        "packages/cli",
        "examples/hello",
        "examples/arena"
    ],
    "scripts": {
        "build": "node scripts/workspace.mjs build",
        "test": "node scripts/workspace.mjs test",
        "generate": "npm run generate --workspace=@nocuft/generator",
        "generate:check": "node scripts/check-generated.mjs",
        "cli": "node packages/cli/dist/main.js",
        "link:cli": "npm link --workspace=@nocuft/cli",
        "register:examples": "npm run build && node scripts/register-examples.mjs",
        "mod:build": "npm run build:mod --workspace=@nocuft/client",
        "mod:install": "npm run install:mod --workspace=@nocuft/client --",
        "mod:run": "npm --prefix packages/client/mod exec -- ./gradlew runClient",
        "check": "npm run generate:check && npm run build && npm test"
    }
}
